<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BackupDriver.App.ViewModels"
             x:Class="BackupDriver.App.Views.ConfigView"
             x:DataType="vm:ConfigViewModel">

    <!-- v1.6: Paleta Obsidian Gold (ADR-01) -->
    <StackPanel Spacing="12">
        <TextBlock Text="⚙️ Configuração Geral" FontSize="24" FontWeight="Bold"
                   Foreground="{DynamicResource AccentSecondary}"/>

        <!-- Firebird Expander -->
        <Expander Header="📁 Firebird" IsExpanded="True">
            <StackPanel Spacing="8" Margin="0,10,0,0">
                <TextBlock Text="Caminho do Firebird (pasta do gbak.exe):" Foreground="{DynamicResource TextMuted}"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" Text="{Binding FirebirdPath}" Watermark="C:\Program Files\Firebird\Firebird_2_5\bin"/>
                    <Button Grid.Column="1" Content="📁" Command="{Binding BrowseFirebirdPathCommand}"
                            ToolTip.Tip="Selecionar pasta" Background="{DynamicResource CardBorder}"
                            Foreground="{DynamicResource AccentSecondary}" Padding="8,6"/>
                </Grid>

                <TextBlock Text="Caminho do banco (.FDB):" Foreground="{DynamicResource TextMuted}"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" Text="{Binding DbPath}" Watermark="C:\Empresa\Dados\DADOS.FDB"/>
                    <Button Grid.Column="1" Content="📁" Command="{Binding BrowseDbPathCommand}"
                            ToolTip.Tip="Selecionar arquivo" Background="{DynamicResource CardBorder}"
                            Foreground="{DynamicResource AccentSecondary}" Padding="8,6"/>
                </Grid>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Usuário:" Foreground="{DynamicResource TextMuted}"/>
                        <TextBox Text="{Binding User}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Senha:" Foreground="{DynamicResource TextMuted}"/>
                        <TextBox Text="{Binding Password}" PasswordChar="•"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Porta:" Foreground="{DynamicResource TextMuted}"/>
                        <NumericUpDown Value="{Binding Port}" Minimum="1" Maximum="65535" FormatString="0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Expander>

        <!-- Backup Expander -->
        <Expander Header="📁 Backup" IsExpanded="True">
            <StackPanel Spacing="8" Margin="0,10,0,0">
                <TextBlock Text="Pasta de saída dos backups:" Foreground="{DynamicResource TextMuted}"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" Text="{Binding BackupOutputPath}" Watermark="C:\Empresa\Backup"/>
                    <Button Grid.Column="1" Content="📁" Command="{Binding BrowseBackupPathCommand}"
                            ToolTip.Tip="Selecionar pasta" Background="{DynamicResource CardBorder}"
                            Foreground="{DynamicResource AccentSecondary}" Padding="8,6"/>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Senha do ZIP:" Foreground="{DynamicResource TextMuted}"/>
                        <TextBox Text="{Binding ZipPassword}" PasswordChar="•"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Retenção (horas):" Foreground="{DynamicResource TextMuted}"/>
                        <NumericUpDown Value="{Binding RetentionHours}" Minimum="1" Maximum="720" FormatString="0"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Nome do cliente:" Foreground="{DynamicResource TextMuted}"/>
                <TextBox Text="{Binding ClientName}" Watermark="NOME-CLIENTE"/>

                <!-- v1.6.1: ADR-H04 — Retenção de logs -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Retenção de logs (dias):" Foreground="{DynamicResource TextMuted}"/>
                        <NumericUpDown Value="{Binding LogRetentionDays}" Minimum="1" Maximum="365" FormatString="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Text="Logs mais antigos serão removidos automaticamente"
                                   FontSize="10" Foreground="White" Opacity="0.7" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Expander>

        <!-- Botões -->
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
            <Button Content="Testar Conexão" Command="{Binding TestConnectionCommand}"
                    Background="{DynamicResource InfoColor}" Foreground="White" Padding="15,8"/>
            <Button Content="🗑️ Limpar" Command="{Binding ClearConfigCommand}"
                    Background="{DynamicResource CardBorder}" Foreground="{DynamicResource AccentSecondary}" Padding="15,8"/>
            <Button Content="💾 Salvar" Command="{Binding SaveConfigCommand}"
                    Background="{DynamicResource SuccessColor}" Foreground="White" Padding="15,8"/>
        </StackPanel>

        <!-- Resultados -->
        <TextBlock Text="{Binding ConnectionTestResult}" Foreground="{DynamicResource InfoColor}"
                   IsVisible="{Binding ConnectionTestResult, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>
        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource InfoColor}"
                   IsVisible="{Binding StatusMessage, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>
    </StackPanel>
</UserControl>