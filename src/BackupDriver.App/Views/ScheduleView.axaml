<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BackupDriver.App.ViewModels"
             x:Class="BackupDriver.App.Views.ScheduleView"
             x:DataType="vm:ScheduleViewModel">

    <!-- v1.6: Paleta Obsidian Gold (ADR-01) -->
    <StackPanel Spacing="15" Margin="10">
        <TextBlock Text="⏰ Agendamento" FontSize="28" FontWeight="ExtraBold"
                   Foreground="{DynamicResource AccentSecondary}">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="10" Opacity="0.5" Color="Black"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- Status do Agendador Interno -->
        <Border CornerRadius="12" Padding="20"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#1E1E20" Offset="0"/>
                    <GradientStop Color="#161618" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Spacing="15">
                <TextBlock Text="🎯 Estado do Serviço" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource AccentSecondary}" HorizontalAlignment="Center"/>
                
                <Grid ColumnDefinitions="*,*">
                    <!-- Indicador Ativo/Pausado -->
                    <StackPanel Grid.Column="0" Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding SchedulerStatusIcon}" FontSize="40" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding SchedulerStatusText}"
                                   Foreground="{DynamicResource AccentSecondary}" FontSize="14"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Próximo Disparo -->
                    <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="Próximo Processamento:" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                        <TextBlock Text="{Binding NextRunTime}" Foreground="{DynamicResource InfoColor}"
                                   FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <Separator Background="{DynamicResource SeparatorColor}" Height="1" Margin="0,5"/>

                <!-- Botões Pausar / Retomar -->
                <Grid ColumnDefinitions="*,*" Margin="0,10,0,0">
                    <Button Grid.Column="0" Content="⏸️ Pausar"
                            Command="{Binding PauseSchedulerCommand}"
                            IsEnabled="{Binding CanPause}"
                            Background="{DynamicResource WarningColor}" Foreground="White"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Padding="15,12" Margin="0,0,5,0" CornerRadius="6" FontWeight="Bold"/>
                    
                    <Button Grid.Column="1" Content="▶️ Retomar"
                            Command="{Binding ResumeSchedulerCommand}"
                            IsEnabled="{Binding CanResume}"
                            Background="{DynamicResource SuccessColor}" Foreground="White"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Padding="15,12" Margin="5,0,0,0" CornerRadius="6" FontWeight="Bold"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Configurações de Frequência -->
        <Border CornerRadius="12" Padding="20"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
            <StackPanel Spacing="15">
                <TextBlock Text="⚙️ Configuração de Frequência" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource AccentSecondary}"/>
                
                <StackPanel Orientation="Horizontal" Spacing="30">
                    <RadioButton Content="Intervalo Regular" IsChecked="{Binding IsIntervalMode}"
                                 Foreground="White" GroupName="ScheduleMode" FontSize="14"/>
                    <RadioButton Content="Horário Diário Fixo" IsChecked="{Binding IsFixedTimeMode}"
                                 Foreground="White" GroupName="ScheduleMode" FontSize="14"/>
                </StackPanel>

                <!-- Painel Alternativo -->
                <Panel>
                    <!-- Modo Intervalo -->
                    <StackPanel Spacing="10" IsVisible="{Binding IsIntervalMode}">
                        <TextBlock Text="Intervalo entre backups (em horas):" Foreground="White"/>
                        <NumericUpDown Value="{Binding IntervalHours}" Minimum="1" Maximum="24" FormatString="0" FontSize="16"/>
                        <TextBlock Text="Dica: Backups mais frequentes garantem menor perda de dados."
                                   Foreground="White" Opacity="0.7" FontSize="11" FontStyle="Italic"/>
                    </StackPanel>

                    <!-- Modo Horário Fixo -->
                    <StackPanel Spacing="10" IsVisible="{Binding IsFixedTimeMode}">
                        <TextBlock Text="Hora do backup diário (HH:mm):" Foreground="White"/>
                        <TextBox Text="{Binding FixedTime}" Watermark="02:00" FontSize="16"/>
                        <TextBlock Text="Exemplo: 02:00 para madrugada ou 22:30 para fim do expediente."
                                   Foreground="White" Opacity="0.7" FontSize="11" FontStyle="Italic"/>
                    </StackPanel>
                </Panel>
            </StackPanel>
        </Border>

        <Button Content="💾 SALVAR E APLICAR CONFIGURAÇÕES"
                Command="{Binding SaveScheduleCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Background="{DynamicResource AccentPrimary}" Foreground="White" Padding="20,15"
                FontSize="16" FontWeight="ExtraBold" CornerRadius="8"/>

        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SuccessColor}" FontWeight="Bold" 
                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10"/>
    </StackPanel>

</UserControl>