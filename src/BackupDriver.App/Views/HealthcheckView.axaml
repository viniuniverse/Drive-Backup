<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BackupDriver.App.ViewModels"
             x:Class="BackupDriver.App.Views.HealthcheckView"
             x:DataType="vm:HealthcheckViewModel">

    <!-- v1.6: Paleta Obsidian Gold (ADR-01) -->
    <ScrollViewer>
        <StackPanel Spacing="12" Margin="10">
            <TextBlock Text="📡 Healthcheck e Notificações" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource AccentSecondary}"/>

            <!-- v1.6.5: ADR-H05 — Seções expansíveis para melhor organização -->
            
            <!-- Seção Healthcheck -->
            <Expander Header="📡 Healthchecks.io" IsExpanded="True">
                <StackPanel Spacing="10" Margin="0,10,0,0">
                    <ToggleSwitch IsChecked="{Binding HealthcheckEnabled}" Foreground="{DynamicResource AccentSecondary}">
                        <ToggleSwitch.OnContent>
                            <TextBlock Text="Habilitado" Margin="15,0,0,0"/>
                        </ToggleSwitch.OnContent>
                        <ToggleSwitch.OffContent>
                            <TextBlock Text="Desabilitado" Margin="15,0,0,0"/>
                        </ToggleSwitch.OffContent>
                    </ToggleSwitch>

                    <TextBlock Text="URL de Monitoramento:" Foreground="{DynamicResource TextMuted}"/>
                    <TextBox Text="{Binding HealthcheckUrl}" Watermark="https://hc-ping.com/xxxxxxxx-xxxx"/>

                    <TextBlock Text="{Binding LastHealthcheckResponse, StringFormat='Última resposta: {0}'}"
                               Foreground="{DynamicResource TextMuted}" FontSize="12"/>

                    <Button Content="🧪 Testar Conexão" Command="{Binding TestHealthcheckCommand}"
                            IsEnabled="{Binding !IsTesting}"
                            Background="{DynamicResource InfoColor}" Foreground="White" Padding="15,8" HorizontalAlignment="Left"/>
                </StackPanel>
            </Expander>

            <!-- Seção Telegram -->
            <Expander Header="📲 Telegram (Notificações)" IsExpanded="True">
                <StackPanel Spacing="10" Margin="0,10,0,0">
                    <ToggleSwitch IsChecked="{Binding TelegramEnabled}" Foreground="{DynamicResource AccentSecondary}">
                        <ToggleSwitch.OnContent>
                            <TextBlock Text="Habilitado" Margin="15,0,0,0"/>
                        </ToggleSwitch.OnContent>
                        <ToggleSwitch.OffContent>
                            <TextBlock Text="Desabilitado" Margin="15,0,0,0"/>
                        </ToggleSwitch.OffContent>
                    </ToggleSwitch>

                    <TextBlock Text="Bot Token:" Foreground="{DynamicResource TextMuted}"/>
                    <TextBox Text="{Binding TelegramBotToken}" PasswordChar="•"/>

                    <TextBlock Text="Chat ID:" Foreground="{DynamicResource TextMuted}"/>
                    <TextBox Text="{Binding TelegramChatId}"/>

                    <Button Content="🧪 Enviar Mensagem de Teste" Command="{Binding TestTelegramCommand}"
                            IsEnabled="{Binding !IsTesting}"
                            Background="{DynamicResource InfoColor}" Foreground="White" Padding="15,8" HorizontalAlignment="Left"/>
                </StackPanel>
            </Expander>

            <Button Content="💾 Salvar" Command="{Binding SaveConfigCommand}"
                    Background="{DynamicResource SuccessColor}" Foreground="White" Padding="15,8"
                    HorizontalAlignment="Left" Margin="0,10,0,0"/>

            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource InfoColor}"
                       IsVisible="{Binding StatusMessage, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
