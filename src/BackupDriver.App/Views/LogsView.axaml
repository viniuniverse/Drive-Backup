<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BackupDriver.App.ViewModels"
             x:Class="BackupDriver.App.Views.LogsView"
             x:DataType="vm:LogsViewModel">

    <!-- v1.6: Paleta Obsidian Gold (ADR-01) -->
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="📋 Logs e Histórico" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource AccentSecondary}"/>
            <Button Grid.Column="1" Content="📁 Abrir Pasta" Command="{Binding OpenLogsFolderCommand}"
                    Background="{DynamicResource InfoColor}" Foreground="White" Padding="10,6"/>
        </Grid>

        <!-- Filtros -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,10,0,10">
            <Button Content="Todos" Command="{Binding FilterAllCommand}"
                    Background="{DynamicResource CardBorder}" Foreground="{DynamicResource AccentSecondary}" Padding="10,6"/>
            <Button Content="Apenas Erros" Command="{Binding FilterErrorsCommand}"
                    Background="{DynamicResource CardBorder}" Foreground="{DynamicResource AccentSecondary}" Padding="10,6"/>
            <Button Content="Apenas Sucesso" Command="{Binding FilterSuccessCommand}"
                    Background="{DynamicResource CardBorder}" Foreground="{DynamicResource AccentSecondary}" Padding="10,6"/>
            <TextBox Text="{Binding SearchText}" Watermark="🔍 Buscar no log..." Width="200"/>
            <Button Content="Buscar" Command="{Binding SearchCommand}"
                    Background="{DynamicResource CardBorder}" Foreground="{DynamicResource AccentSecondary}" Padding="10,6"/>
        </StackPanel>

        <!-- Lista de Logs -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackground}" CornerRadius="8" Padding="5"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Logs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LogEntryViewModel}">
                            <Border Padding="8,4" BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource SeparatorColor}">
                                <Grid ColumnDefinitions="20,*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding LevelIcon}" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayText}"
                                               Foreground="{Binding Level, Converter={x:Static vm:LogLevelToColorConverter.Instance}}"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="3" Text="{Binding DisplayCount}" Foreground="{DynamicResource TextMuted}" Margin="0,5,0,0"/>
    </Grid>
</UserControl>
