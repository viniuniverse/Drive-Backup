<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BackupDriver.App.ViewModels"
             xmlns:core="using:BackupDriver.Core.Backup"
             xmlns:v="using:BackupDriver.App.Views"
             x:Class="BackupDriver.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <!-- v1.6: Dashboard com paleta Obsidian Gold (ADR-01 + ADR-02) -->
    <DockPanel>
        <!-- Barra de ações no topo -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackground}" Padding="10" Margin="0,0,0,5">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15">
                    <Button Content="▶️ EXECUTAR BACKUP AGORA"
                            Command="{Binding ExecuteBackupCommand}"
                            IsEnabled="{Binding !IsBackupRunning}"
                            Background="{DynamicResource SuccessColor}" Foreground="White"
                            Padding="30,12" FontSize="15" FontWeight="Bold" CornerRadius="6"
                            ToolTip.Tip="Clique para iniciar um backup manual agora"/>

                    <Button Content="⏳ PROCESSANDO..."
                            IsEnabled="False"
                            IsVisible="{Binding IsBackupRunning}"
                            Background="{DynamicResource WarningColor}" Foreground="White"
                            Padding="30,12" FontSize="15" FontWeight="Bold" CornerRadius="6"/>

                    <Button Content="⛔ CANCELAR"
                            Command="{Binding CancelBackupCommand}"
                            IsVisible="{Binding IsBackupRunning}"
                            Background="{DynamicResource ErrorColor}" Foreground="White"
                            Padding="30,12" FontSize="15" FontWeight="Bold" CornerRadius="6"/>
                </StackPanel>

                <!-- v1.6: T-1.6.25 — ProgressBar com valor real durante backup -->
                <ProgressBar IsIndeterminate="{Binding !ShowRealProgress}"
                             Value="{Binding ProgressValue}"
                             IsVisible="{Binding IsBackupRunning}"
                             Foreground="{DynamicResource AccentPrimary}"
                             Background="{DynamicResource CardBorder}"
                             Height="6" CornerRadius="3"/>
            </StackPanel>
        </Border>

        <!-- v1.6.1: ADR-H02 — Layout adaptativo sem ScrollViewer fixo -->
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- v1.6: T-1.6.24 — Versão pública V1 -->
            <TextBlock Grid.Row="0" Text="🏠 Dashboard — Backup Driver V1" FontSize="28" FontWeight="ExtraBold"
                       Foreground="{DynamicResource AccentSecondary}" Margin="0,0,0,20"/>

            <!-- Bento Grid Layout -->
            <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*"
                  VerticalAlignment="Stretch">
                <!-- Widget 1: Status do Sistema (Full Width) -->
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10"
                        CornerRadius="12" Padding="20"
                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                        BoxShadow="0 4 12 0 #30000000">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#1E1E20" Offset="0"/>
                            <GradientStop Color="#161618" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Spacing="15">
                        <TextBlock Text="🌐 Status do Sistema" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentSecondary}"/>
                        <Grid ColumnDefinitions="*,*,*">
                            <StackPanel Grid.Column="0" Spacing="5" HorizontalAlignment="Center">
                                <TextBlock Text="Google Drive" Foreground="{DynamicResource TextMuted}" FontSize="12" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding GoogleDriveStatus}" FontWeight="ExtraBold" FontSize="16"
                                           Foreground="{Binding IsGoogleDriveActive, Converter={x:Static v:StatusColorConverter.Instance}}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5" HorizontalAlignment="Center">
                                <TextBlock Text="Healthcheck" Foreground="{DynamicResource TextMuted}" FontSize="12" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding HealthcheckStatus}" FontWeight="ExtraBold" FontSize="16"
                                           Foreground="{Binding IsHealthcheckActive, Converter={x:Static v:StatusColorConverter.Instance}}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="5" HorizontalAlignment="Center">
                                <TextBlock Text="Agendador" Foreground="{DynamicResource TextMuted}" FontSize="12" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding SchedulerStatus}" FontWeight="ExtraBold" FontSize="16"
                                           Foreground="{Binding SchedulerStatus, Converter={x:Static v:SchedulerStatusColorConverter.Instance}}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Widget 2: Último Backup -->
                <Border Grid.Row="1" Grid.Column="0" Margin="0,0,5,10"
                        CornerRadius="12" Padding="15"
                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                        BoxShadow="0 4 12 0 #30000000">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#1E1E20" Offset="0"/>
                            <GradientStop Color="#161618" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Spacing="10">
                        <TextBlock Text="📊 Último Backup" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource InfoColor}"/>
                        <Separator Background="{DynamicResource SeparatorColor}" Height="1" Opacity="0.3"/>
                        <TextBlock Text="{Binding LastBackupDate, StringFormat='📅 Data: {0}'}"
                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding LastBackupStatus, StringFormat='🎯 Status: {0}'}"
                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding LastBackupFile, StringFormat='📄 Arquivo: {0}'}"
                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding LastBackupDuration, StringFormat='⏱️ Duração: {0}'}"
                                   Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                </Border>

                <!-- Widget 3: Próximo Backup -->
                <Border Grid.Row="1" Grid.Column="1" Margin="5,0,0,10"
                        CornerRadius="12" Padding="15"
                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                        BoxShadow="0 4 12 0 #30000000">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#1E1E20" Offset="0"/>
                            <GradientStop Color="#161618" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Spacing="10">
                        <TextBlock Text="🔄 Próximo Backup" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SuccessColor}"/>
                        <Separator Background="{DynamicResource SeparatorColor}" Height="1" Opacity="0.3"/>
                        <TextBlock Text="{Binding NextBackupTime}"
                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                        <TextBlock Text="Mantenha o app em execução ou na bandeja."
                                   FontSize="11" Foreground="{DynamicResource CardBorder}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- v1.6: T-1.6.26 — Widget 4: Google Drive (Bento Box novo) -->
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10"
                        CornerRadius="12" Padding="15"
                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                        BoxShadow="0 4 12 0 #30000000">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#1E1E20" Offset="0"/>
                            <GradientStop Color="#161618" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Spacing="10">
                        <TextBlock Text="☁️ Google Drive" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentPrimary}"/>
                        <Separator Background="{DynamicResource SeparatorColor}" Height="1" Opacity="0.3"/>
                        <Grid ColumnDefinitions="*,*,*">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Text="Status" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                                <TextBlock Text="{Binding CloudStatus}" FontWeight="Bold" FontSize="14"
                                           Foreground="{DynamicResource AccentSecondary}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="Cliente" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                                <TextBlock Text="{Binding ClientName}" FontWeight="Bold" FontSize="14"
                                           Foreground="{DynamicResource AccentSecondary}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="3">
                                <TextBlock Text="Último Upload" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                                <TextBlock Text="{Binding LastCloudUploadDate}" FontWeight="Bold" FontSize="14"
                                           Foreground="{DynamicResource AccentSecondary}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- v1.6.1: ADR-H03 — Aviso de configuração incompleta + Footer -->
            <StackPanel Grid.Row="2" Spacing="10" Margin="0,10,0,0">
                <!-- Aviso de configuração incompleta removido na V1 Release -->

                <!-- v1.6: T-1.6.27 — Footer com créditos do desenvolvedor -->
                <Border CornerRadius="8" Padding="15"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="Desenvolvido por Vinicius Gadelha"
                                   Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
                            <Button Content="💼 LinkedIn" Command="{Binding OpenLinkedInCommand}"
                                    Background="Transparent" Foreground="{DynamicResource InfoColor}"
                                    Padding="8,4" FontSize="12" BorderThickness="0" Cursor="Hand"/>
                            <Button Content="🐙 GitHub" Command="{Binding OpenGitHubCommand}"
                                    Background="Transparent" Foreground="{DynamicResource InfoColor}"
                                    Padding="8,4" FontSize="12" BorderThickness="0" Cursor="Hand"/>
                            <TextBlock Text="📧 viniciusdsgadelha@gmail.com"
                                       Foreground="{DynamicResource TextMuted}" FontSize="11"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>